{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pickleball Gyan venue record",
  "type": "object",
  "required": ["id", "name", "city", "state", "locality", "status", "verification_status", "publication_status", "court_type", "court_count", "indoor_outdoor", "coordinates", "geocode_status", "source", "date_checked", "refresh_due", "map_query", "editor_notes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "city": { "type": "string" },
    "state": { "type": "string" },
    "locality": { "type": "string" },
    "address": { "type": "string" },
    "status": { "enum": ["open", "temporarily_closed", "closed", "unknown"] },
    "verification_status": { "enum": ["verified", "reported", "estimated", "unverified"] },
    "publication_status": { "enum": ["published", "research_only", "archived"] },
    "coordinates": { "type": ["object", "null"], "properties": { "latitude": { "type": "number" }, "longitude": { "type": "number" }, "source": { "type": "string" }, "matched_name": { "type": "string" } } },
    "geocode_status": { "enum": ["matched_named_place", "not_geocoded", "needs_review"] },
    "location_source": { "type": "object", "properties": { "url": { "type": "string", "format": "uri" }, "publisher": { "type": "string" }, "source_type": { "type": "string" } } },
    "date_checked": { "type": "string", "format": "date" },
    "source": { "type": "object", "required": ["url", "publisher", "source_type"], "properties": { "url": { "type": "string", "format": "uri" }, "publisher": { "type": "string" }, "source_type": { "enum": ["venue", "operator", "booking_platform", "social", "direct_confirmation", "other"] } } },
    "court_type": { "enum": ["dedicated", "multi_use_permanent_lines", "temporary_lines", "unknown"] },
    "court_count": { "type": ["integer", "null"], "minimum": 0 },
    "indoor_outdoor": { "enum": ["indoor", "outdoor", "both", "unknown"] },
    "surface": { "type": ["string", "null"] },
    "pricing": { "type": ["string", "null"] },
    "booking_method": { "type": ["string", "null"] },
    "editor_notes": { "type": "string" },
    "refresh_due": { "type": "string", "format": "date" },
    "map_query": { "type": "string" }
  }
}

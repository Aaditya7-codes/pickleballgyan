{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pickleball Gyan venue record",
  "type": "object",
  "required": ["name", "city", "state", "status", "verification_status", "date_checked", "sources", "court_type", "editor_notes", "updated_at"],
  "properties": {
    "name": { "type": "string" },
    "city": { "type": "string" },
    "state": { "type": "string" },
    "status": { "enum": ["open", "temporarily_closed", "closed", "unknown"] },
    "verification_status": { "enum": ["verified", "reported", "estimated", "unverified"] },
    "date_checked": { "type": "string", "format": "date" },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["url", "source_type", "accessed_at"], "properties": { "url": { "type": "string", "format": "uri" }, "source_type": { "enum": ["venue", "operator", "booking_platform", "social", "direct_confirmation", "other"] }, "accessed_at": { "type": "string", "format": "date" } } } },
    "court_type": { "enum": ["dedicated", "multi_use_permanent_lines", "temporary_lines", "unknown"] },
    "court_count": { "type": ["integer", "null"], "minimum": 0 },
    "indoor_outdoor": { "enum": ["indoor", "outdoor", "both", "unknown"] },
    "surface": { "type": ["string", "null"] },
    "pricing": { "type": ["string", "null"] },
    "booking_method": { "type": ["string", "null"] },
    "editor_notes": { "type": "string" },
    "updated_at": { "type": "string", "format": "date" }
  }
}
